<Window x:Class="StairsPlugin.Views.StairGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:viewmodel="clr-namespace:StairsPlugin.ViewModel" 
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=viewmodel:ViewModel, IsDesignTimeCreatable=False}"
        Title="双跑平行楼梯生成" Height="900" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- ===== 转换器 ===== -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== 色彩资源 ===== -->
        <SolidColorBrush x:Key="BorderBrush"    Color="#CCCCCC"/>
        <SolidColorBrush x:Key="SectionTitleFg" Color="#888888"/>
        <SolidColorBrush x:Key="LabelFg"        Color="#555555"/>
        <SolidColorBrush x:Key="UnitFg"         Color="#999999"/>
        <SolidColorBrush x:Key="CoordFg"        Color="#777777"/>
        <SolidColorBrush x:Key="InfoBlue"       Color="#1565C0"/>
        <SolidColorBrush x:Key="InfoBlueBg"     Color="#E3F2FD"/>
        <SolidColorBrush x:Key="OkGreen"        Color="#2E7D32"/>
        <SolidColorBrush x:Key="OkGreenBg"      Color="#E8F5E9"/>
        <SolidColorBrush x:Key="WarnOrange"     Color="#E65100"/>
        <SolidColorBrush x:Key="WarnOrangeBg"   Color="#FFF3E0"/>
        <SolidColorBrush x:Key="DangerRed"      Color="#B71C1C"/>
        <SolidColorBrush x:Key="DangerRedBg"    Color="#FFEBEE"/>
        <SolidColorBrush x:Key="PreviewBg"      Color="#EEEEEE"/>
        <SolidColorBrush x:Key="DividerBrush"   Color="#E0E0E0"/>

        <!-- ===== 通用样式 ===== -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="{StaticResource LabelFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="88"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SectionTitleFg}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="Height"                    Value="28"/>
            <Setter Property="Padding"                   Value="6,0"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Background"                Value="White"/>
            <Setter Property="BorderBrush"               Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"           Value="1"/>
        </Style>
        <Style x:Key="NumBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="Height"                    Value="28"/>
            <Setter Property="Width"                     Value="80"/>
            <Setter Property="Padding"                   Value="6,0"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Background"                Value="White"/>
            <Setter Property="BorderBrush"               Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="TextAlignment"             Value="Right"/>
        </Style>
        <Style x:Key="PickBtnStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="#EEEEEE"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Background"      Value="{StaticResource InfoBlueBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource InfoBlue}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource InfoBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Width"           Value="80"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource LabelFg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,14,16,4">
            <StackPanel>

                <!-- ============================================================ -->
                <!--  区块一：空间定位                                               -->
                <!-- ============================================================ -->
                <TextBlock Text="空间定位" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 底部标高：ItemsSource 绑定 LevelDisplayNames，SelectedIndex 双向绑定 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="底部标高"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1"
                               Style="{StaticResource ComboStyle}"
                               ItemsSource="{Binding LevelDisplayNames}"
                               SelectedIndex="{Binding BaseLevelIndex, Mode=TwoWay}"/>
                </Grid>

                <!-- 顶部标高 + 总高显示 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="顶部标高"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1"
                               Style="{StaticResource ComboStyle}"
                               ItemsSource="{Binding LevelDisplayNames}"
                               SelectedIndex="{Binding TopLevelIndex, Mode=TwoWay}"/>
                    <!-- 总高：绑定 TotalHeightDisplay -->
                    <Border Grid.Column="2" Margin="8,0,0,0"
                            Background="{StaticResource InfoBlueBg}"
                            BorderBrush="{StaticResource InfoBlue}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="8,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalHeightDisplay}" FontSize="11"
                                   Foreground="{StaticResource InfoBlue}"/>
                    </Border>
                </Grid>

                <!-- 底部偏移：双向绑定 BaseOffsetMm -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="底部偏移"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" Style="{StaticResource NumBoxStyle}"
                               Text="{Binding BaseOffsetMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,0,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ============================================================ -->
                <!--  区块二：平面定位与方向（两点向量法）                              -->
                <!-- ============================================================ -->
                <TextBlock Style="{StaticResource SectionTitleStyle}">
                    平面定位与方向
                    <Run Foreground="{StaticResource InfoBlue}" FontSize="10"> 两点向量法</Run>
                </TextBlock>
                <Border BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- P1 拾取：Click 保留在 Code-behind（必须调用 UIDocument.Selection） -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="插入点 P1"
                               Style="{StaticResource LabelStyle}"/>
                    <Button    Grid.Column="1" Content="在视图中拾取"
                               Style="{StaticResource PickBtnStyle}"
                               Click="BtnPickP1_Click"/>
                    <!-- 坐标显示绑定 P1Display -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding P1Display}"
                               FontSize="11" Margin="8,0,0,0"
                               Foreground="{StaticResource CoordFg}"
                               VerticalAlignment="Center" FontFamily="Consolas"/>
                </Grid>

                <!-- P2 拾取：IsEnabled 绑定 CanPickP2 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="方向点 P2"
                               Style="{StaticResource LabelStyle}"/>
                    <Button    Grid.Column="1" Content="在视图中拾取"
                               Style="{StaticResource PickBtnStyle}"
                               IsEnabled="{Binding CanPickP2}"
                               Click="BtnPickP2_Click"/>
                    <!-- 坐标显示绑定 P2Display -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding P2Display}"
                               FontSize="11" Margin="8,0,0,0"
                               Foreground="{StaticResource CoordFg}"
                               VerticalAlignment="Center" FontFamily="Consolas"/>
                </Grid>

                <!-- 方向角提示：绑定 ThetaDisplay -->
                <Grid Margin="88,0,0,7">
                    <TextBlock Text="{Binding ThetaDisplay}" FontSize="11"
                               Foreground="{StaticResource CoordFg}"/>
                </Grid>

                <Border BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Margin="0,4,0,8"/>

                <!-- 盘旋方向：RadioButton 绑定 IsClockwise -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="盘旋方向"
                               Style="{StaticResource LabelStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <RadioButton Content="右旋（顺时针）" FontSize="12"
                                     IsChecked="{Binding IsClockwise, Mode=TwoWay}"
                                     Margin="0,0,20,0"/>
                        <!-- 左旋：绑定 IsClockwise 取反 -->
                        <RadioButton Content="左旋（逆时针）" FontSize="12"
                                     IsChecked="{Binding IsClockwise,
                                         Mode=TwoWay,
                                         Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!--  区块三：规范与类型                                              -->
                <!-- ============================================================ -->
                <TextBlock Text="规范与类型" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 建筑功能类型：静态 Item + SelectedIndex 双向绑定 BuildingTypeIndex -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="建筑功能类型"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1" Style="{StaticResource ComboStyle}"
                               SelectedIndex="{Binding BuildingTypeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="住宅"/>
                        <ComboBoxItem Content="一般公共建筑"/>
                        <ComboBoxItem Content="附属楼梯（多层/高层）"/>
                        <ComboBoxItem Content="附属楼梯（超高层）"/>
                    </ComboBox>
                </Grid>

                <!-- 楼梯族类型：ItemsSource 绑定 StairsTypeNames -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="楼梯族类型"
                               Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1" Style="{StaticResource ComboStyle}"
                               ItemsSource="{Binding StairsTypeNames}"
                               SelectedIndex="{Binding StairsTypeIndex, Mode=TwoWay}"/>
                </Grid>

                <!-- ============================================================ -->
                <!--  区块四：几何参数                                               -->
                <!-- ============================================================ -->
                <TextBlock Text="几何参数" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 梯段净宽：双向绑定 + Badge DataTrigger 根据 RunWidthOk 切色 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="梯段净宽"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" Style="{StaticResource NumBoxStyle}"
                               Text="{Binding RunWidthMm, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,8,0"
                               Foreground="{StaticResource UnitFg}"
                               VerticalAlignment="Center"/>
                    <!-- Badge：DataTrigger 绑定 RunWidthOk -->
                    <Border Grid.Column="3" CornerRadius="10" Padding="6,1"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"   Value="{StaticResource OkGreenBg}"/>
                                <Setter Property="BorderBrush"  Value="{StaticResource OkGreen}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunWidthOk}" Value="False">
                                        <Setter Property="Background"  Value="{StaticResource WarnOrangeBg}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WarnOrange}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RunWidthBadgeText}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource OkGreen}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunWidthOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource WarnOrange}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- 踏步宽度：双向绑定 + Badge DataTrigger 绑定 TreadDepthOk -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="踏步宽度 b"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" Style="{StaticResource NumBoxStyle}"
                               Text="{Binding TreadDepthMm, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,8,0"
                               Foreground="{StaticResource UnitFg}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="3" CornerRadius="10" Padding="6,1"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"  Value="{StaticResource OkGreenBg}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource OkGreen}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TreadDepthOk}" Value="False">
                                        <Setter Property="Background"  Value="{StaticResource WarnOrangeBg}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource WarnOrange}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TreadDepthBadgeText}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource OkGreen}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TreadDepthOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource WarnOrange}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- 梯井宽度 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="梯井宽度"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" Style="{StaticResource NumBoxStyle}"
                               Text="{Binding WellWidthMm, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,0,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 休息平台深度 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="休息平台深"
                               Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" Style="{StaticResource NumBoxStyle}"
                               Text="{Binding LandingDepthMm, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,8,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                    <Border Grid.Column="3"
                            Background="{StaticResource InfoBlueBg}"
                            BorderBrush="{StaticResource InfoBlue}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="默认同梯段净宽" FontSize="10"
                                   Foreground="{StaticResource InfoBlue}"/>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!--  区块五：辅助选项                                               -->
                <!-- ============================================================ -->
                <TextBlock Text="辅助选项" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 生成扶手：CheckBox 绑定 GenerateRailing；下拉 IsEnabled 联动 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding GenerateRailing, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="生成扶手栏杆" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{StaticResource LabelFg}"/>
                    <!-- 栏杆类型：ItemsSource + IsEnabled 联动 GenerateRailing -->
                    <ComboBox Grid.Column="2" Style="{StaticResource ComboStyle}"
                              ItemsSource="{Binding RailingTypeNames}"
                              SelectedIndex="{Binding RailingTypeIndex, Mode=TwoWay}"
                              IsEnabled="{Binding GenerateRailing}"/>
                </Grid>

                <!-- 净空校验：CheckBox 绑定 EnableClearCheck -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding EnableClearCheck, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource LabelFg}">
                        开启净空合规校验
                        <Run Foreground="{StaticResource CoordFg}" FontSize="10"
                             >（代数几何高程算法）</Run>
                    </TextBlock>
                </Grid>

                <!-- ============================================================ -->
                <!--  实时预览区                                                     -->
                <!-- ============================================================ -->
                <Border Background="{StaticResource PreviewBg}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,10" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="踏步级数" FontSize="10"
                                           Foreground="{StaticResource LabelFg}"/>
                                <!-- 绑定 PreviewSteps -->
                                <TextBlock Text="{Binding PreviewSteps}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="踢面高 h" FontSize="10"
                                           Foreground="{StaticResource LabelFg}"/>
                                <!-- 绑定 PreviewRiser -->
                                <TextBlock Text="{Binding PreviewRiser}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每跑分配" FontSize="10"
                                           Foreground="{StaticResource LabelFg}"/>
                                <!-- 绑定 PreviewDist -->
                                <TextBlock Text="{Binding PreviewDist}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>

                        <!-- 规范依据：绑定 PreviewRule -->
                        <TextBlock Text="{Binding PreviewRule, StringFormat='规范依据：{0}'}"
                                   FontSize="10" Foreground="{StaticResource CoordFg}"
                                   Margin="0,4,0,0"/>

                        <!-- 违规警告：Visibility 绑定 HasViolation（BoolToVis） -->
                        <Border Visibility="{Binding HasViolation,
                                             Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource DangerRedBg}"
                                BorderBrush="{StaticResource DangerRed}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8,6" Margin="0,8,0,0">
                            <!-- 违规文字：绑定 ViolationDetail -->
                            <TextBlock Text="{Binding ViolationDetail}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource DangerRed}"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!--  底部按钮栏                                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="#F5F5F5" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 取消：Click 保留在 Code-behind，纯窗口行为 -->
                <Button Grid.Column="0" Content="取消"
                        Style="{StaticResource CancelBtnStyle}"
                        Click="BtnCancel_Click"/>
                <!-- 生成：Command 绑定 GenerateCommand（CanExecute 自动控制 IsEnabled） -->
                <Button Grid.Column="1"
                        Content="生成楼梯"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Margin="12,0,0,0"
                        Command="{Binding GenerateCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
