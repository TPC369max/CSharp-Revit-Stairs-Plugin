<Window x:Class="StairsPlugin.StairGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双跑平行楼梯生成" Height="680" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- ===== 基础色定义 ===== -->
        <SolidColorBrush x:Key="BorderBrush"     Color="#CCCCCC"/>
        <SolidColorBrush x:Key="SectionTitleFg"  Color="#888888"/>
        <SolidColorBrush x:Key="LabelFg"         Color="#555555"/>
        <SolidColorBrush x:Key="UnitFg"          Color="#999999"/>
        <SolidColorBrush x:Key="CoordFg"         Color="#777777"/>
        <SolidColorBrush x:Key="InfoBlue"        Color="#1565C0"/>
        <SolidColorBrush x:Key="InfoBlueBg"      Color="#E3F2FD"/>
        <SolidColorBrush x:Key="OkGreen"         Color="#2E7D32"/>
        <SolidColorBrush x:Key="OkGreenBg"       Color="#E8F5E9"/>
        <SolidColorBrush x:Key="WarnOrange"      Color="#E65100"/>
        <SolidColorBrush x:Key="WarnOrangeBg"    Color="#FFF3E0"/>
        <SolidColorBrush x:Key="DangerRed"       Color="#B71C1C"/>
        <SolidColorBrush x:Key="DangerRedBg"     Color="#FFEBEE"/>
        <SolidColorBrush x:Key="PreviewBg"       Color="#EEEEEE"/>
        <SolidColorBrush x:Key="DividerBrush"    Color="#E0E0E0"/>

        <!-- ===== 通用 TextBlock：标签 ===== -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="Foreground"         Value="{StaticResource LabelFg}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Width"              Value="88"/>
        </Style>

        <!-- ===== 区块标题 ===== -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SectionTitleFg}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ===== 通用 ComboBox ===== -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Height"            Value="28"/>
            <Setter Property="Padding"           Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"        Value="White"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
        </Style>

        <!-- ===== 通用数值输入框 ===== -->
        <Style x:Key="NumBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Height"            Value="28"/>
            <Setter Property="Width"             Value="80"/>
            <Setter Property="Padding"           Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"        Value="White"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="TextAlignment"     Value="Right"/>
        </Style>

        <!-- ===== 拾取按钮 ===== -->
        <Style x:Key="PickBtnStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="#EEEEEE"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- ===== 生成按钮 ===== -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Background"      Value="{StaticResource InfoBlueBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource InfoBlue}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource InfoBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- ===== 取消按钮 ===== -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Width"           Value="80"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource LabelFg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- ===== 合规徽章（TextBlock 套 Border） ===== -->
        <Style x:Key="BadgeOk" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource OkGreenBg}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource OkGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="10"/>
            <Setter Property="Padding"        Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeWarn" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource WarnOrangeBg}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource WarnOrange}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="10"/>
            <Setter Property="Padding"        Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- ===== 主体：可滚动内容区 ===== -->
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,14,16,4">
            <StackPanel>

                <!-- ======================================================== -->
                <!--  第一区块：空间定位                                         -->
                <!-- ======================================================== -->
                <TextBlock Text="空间定位" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 底部标高 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="底部标高" Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1" x:Name="CmbBaseLevel"
                               Style="{StaticResource ComboStyle}"
                               SelectionChanged="CmbLevel_Changed"/>
                </Grid>

                <!-- 顶部标高 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="顶部标高" Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1" x:Name="CmbTopLevel"
                               Style="{StaticResource ComboStyle}"
                               SelectionChanged="CmbLevel_Changed"/>
                    <!-- 总高实时显示 -->
                    <Border Grid.Column="2" Margin="8,0,0,0"
                            Background="{StaticResource InfoBlueBg}"
                            BorderBrush="{StaticResource InfoBlue}"
                            BorderThickness="1" CornerRadius="10" Padding="8,1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTotalHeight" FontSize="11"
                                   Foreground="{StaticResource InfoBlue}"
                                   Text="总高 — mm"/>
                    </Border>
                </Grid>

                <!-- 底部偏移 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="底部偏移" Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="TxtBaseOffset"
                               Style="{StaticResource NumBoxStyle}" Text="0"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,0,0"
                               Foreground="{StaticResource UnitFg}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ======================================================== -->
                <!--  第二区块：平面定位与方向（两点向量法）                        -->
                <!-- ======================================================== -->
                <TextBlock Style="{StaticResource SectionTitleStyle}">
                    平面定位与方向
                    <Run Foreground="{StaticResource InfoBlue}" FontSize="10"> 两点向量法</Run>
                </TextBlock>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 插入点 P1 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="插入点 P1" Style="{StaticResource LabelStyle}"/>
                    <Button    Grid.Column="1" x:Name="BtnPickP1"
                               Content="在视图中拾取"
                               Style="{StaticResource PickBtnStyle}"
                               Click="BtnPickP1_Click"/>
                    <TextBlock Grid.Column="2" x:Name="TxtCoordP1"
                               Text="未拾取" FontSize="11" Margin="8,0,0,0"
                               Foreground="{StaticResource CoordFg}"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- 方向点 P2 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="方向点 P2" Style="{StaticResource LabelStyle}"/>
                    <Button    Grid.Column="1" x:Name="BtnPickP2"
                               Content="在视图中拾取"
                               Style="{StaticResource PickBtnStyle}"
                               IsEnabled="False"
                               Click="BtnPickP2_Click"/>
                    <TextBlock Grid.Column="2" x:Name="TxtCoordP2"
                               Text="请先拾取 P1" FontSize="11" Margin="8,0,0,0"
                               Foreground="{StaticResource CoordFg}"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- 计算方向角提示 -->
                <Grid Margin="88,0,0,7">
                    <TextBlock x:Name="TxtTheta" FontSize="11"
                               Foreground="{StaticResource CoordFg}"
                               Text="P1 → P2 决定楼梯爬升朝向，θ = —"/>
                </Grid>

                <!-- 分割线 -->
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                        Margin="0,4,0,8"/>

                <!-- 盘旋方向 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="盘旋方向" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbClockwise" Content="右旋（顺时针）"
                                     FontSize="12" IsChecked="True" Margin="0,0,20,0"/>
                        <RadioButton x:Name="RbCounterClockwise" Content="左旋（逆时针）"
                                     FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!--  第三区块：规范与类型                                        -->
                <!-- ======================================================== -->
                <TextBlock Text="规范与类型" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 建筑功能类型 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="建筑功能类型" Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1" x:Name="CmbBuildingType"
                               Style="{StaticResource ComboStyle}"
                               SelectionChanged="CmbBuildingType_Changed">
                        <ComboBoxItem Content="住宅"             Tag="Residential" IsSelected="True"/>
                        <ComboBoxItem Content="一般公共建筑"       Tag="Public"/>
                        <ComboBoxItem Content="附属楼梯（多层/高层）" Tag="Attached"/>
                        <ComboBoxItem Content="附属楼梯（超高层）"   Tag="Supertall"/>
                    </ComboBox>
                </Grid>

                <!-- 楼梯族类型 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="楼梯族类型" Style="{StaticResource LabelStyle}"/>
                    <ComboBox  Grid.Column="1" x:Name="CmbStairsType"
                               Style="{StaticResource ComboStyle}"/>
                </Grid>

                <!-- ======================================================== -->
                <!--  第四区块：几何参数                                          -->
                <!-- ======================================================== -->
                <TextBlock Text="几何参数" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 梯段净宽 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="梯段净宽" Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="TxtRunWidth"
                               Style="{StaticResource NumBoxStyle}" Text="1200"
                               TextChanged="GeomParam_Changed"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,8,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                    <Border    Grid.Column="3" x:Name="BadgeRunWidth"
                               Style="{StaticResource BadgeOk}" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtBadgeRunWidth" Text="合规" FontSize="10"
                                   Foreground="{StaticResource OkGreen}"/>
                    </Border>
                </Grid>

                <!-- 踏步宽度 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="踏步宽度 b" Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="TxtTreadDepth"
                               Style="{StaticResource NumBoxStyle}" Text="260"
                               TextChanged="GeomParam_Changed"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,8,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                    <Border    Grid.Column="3" x:Name="BadgeTread"
                               Style="{StaticResource BadgeOk}" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtBadgeTread" Text="合规" FontSize="10"
                                   Foreground="{StaticResource OkGreen}"/>
                    </Border>
                </Grid>

                <!-- 梯井宽度 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="梯井宽度" Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="TxtWellWidth"
                               Style="{StaticResource NumBoxStyle}" Text="100"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,0,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 休息平台深度 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="休息平台深" Style="{StaticResource LabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="TxtLandingDepth"
                               Style="{StaticResource NumBoxStyle}" Text="1200"/>
                    <TextBlock Grid.Column="2" Text="mm" FontSize="12" Margin="6,0,8,0"
                               Foreground="{StaticResource UnitFg}" VerticalAlignment="Center"/>
                    <!-- 联动提示：默认同梯段净宽 -->
                    <Border Grid.Column="3"
                            Background="{StaticResource InfoBlueBg}"
                            BorderBrush="{StaticResource InfoBlue}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="默认同梯段净宽" FontSize="10"
                                   Foreground="{StaticResource InfoBlue}"/>
                    </Border>
                </Grid>

                <!-- ======================================================== -->
                <!--  第五区块：辅助选项                                          -->
                <!-- ======================================================== -->
                <TextBlock Text="辅助选项" Style="{StaticResource SectionTitleStyle}"/>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                <!-- 生成扶手栏杆 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkRailing" Grid.Column="0" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="ChkRailing_Changed" Unchecked="ChkRailing_Changed"/>
                    <TextBlock Grid.Column="1" Text="生成扶手栏杆" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{StaticResource LabelFg}"/>
                    <ComboBox  Grid.Column="2" x:Name="CmbRailingType"
                               Style="{StaticResource ComboStyle}"/>
                </Grid>

                <!-- 净空合规校验 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkClearance" Grid.Column="0" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource LabelFg}">
                        开启净空合规校验
                        <Run Foreground="{StaticResource CoordFg}" FontSize="10">（代数几何高程算法）</Run>
                    </TextBlock>
                </Grid>

                <!-- ======================================================== -->
                <!--  实时预览区                                                 -->
                <!-- ======================================================== -->
                <Border Background="{StaticResource PreviewBg}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,10" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- 推算结果行 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="踏步级数" FontSize="10"
                                           Foreground="{StaticResource LabelFg}"/>
                                <TextBlock x:Name="TxtPreviewSteps" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas" Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="踢面高 h" FontSize="10"
                                           Foreground="{StaticResource LabelFg}"/>
                                <TextBlock x:Name="TxtPreviewRiser" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas" Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="每跑分配" FontSize="10"
                                           Foreground="{StaticResource LabelFg}"/>
                                <TextBlock x:Name="TxtPreviewDist" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas" Text="—"/>
                            </StackPanel>
                        </Grid>

                        <!-- 规范依据 -->
                        <TextBlock x:Name="TxtPreviewRule" FontSize="10"
                                   Foreground="{StaticResource CoordFg}"
                                   Margin="0,4,0,0" Text="规范依据：—"/>

                        <!-- 违规警告（默认折叠） -->
                        <Border x:Name="PanelWarn" Visibility="Collapsed"
                                Background="{StaticResource DangerRedBg}"
                                BorderBrush="{StaticResource DangerRed}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8,6" Margin="0,8,0,0">
                            <TextBlock x:Name="TxtWarnDetail" FontSize="11"
                                       Foreground="{StaticResource DangerRed}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!--  底部按钮栏（固定）                                          -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="#F5F5F5" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="取消"
                        Style="{StaticResource CancelBtnStyle}"
                        Click="BtnCancel_Click"/>
                <Button Grid.Column="1" x:Name="BtnGenerate"
                        Content="生成楼梯"
                        Style="{StaticResource PrimaryBtnStyle}"
                        Margin="12,0,0,0"
                        Click="BtnGenerate_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
